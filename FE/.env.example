# Vite chi doc bien co prefix VITE_ (khong phai REACT_APP_ - do la cua
# Create React App, khong ap dung cho project Vite nay).
#
# KHONG dat file nay ten ".env" cho gia tri server that (se lam hong
# `npm run dev` local - Vite doc ca luc dev lan build). Neu can build production
# (Docker) tro toi 1 server that, dat gia tri do trong ".env.production" thay
# vi ".env" - file do chi duoc doc luc `npm run build`, khong anh huong dev.
VITE_API_BASE_URL=http://localhost:5000/api
