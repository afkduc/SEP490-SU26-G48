# Next.js chi doc bien co prefix NEXT_PUBLIC_ o phia client (server thi doc
# duoc tat ca). File nay chi la mau - copy thanh ".env.local" de chay
# `npm run dev` cuc bo (Next tu doc ".env.local", khong commit file do).
#
# NEXT_PUBLIC_API_BASE_URL: dia chi BE ma trinh duyet khach se goi toi - phai
# la dia chi that (khong dung host.docker.internal, xem giai thich trong
# FE/.env.example).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# NEXT_PUBLIC_SITE_URL: domain public cua landing page (dung de sinh
# sitemap.xml / robots.txt / Open Graph). Doi lai khi co domain that.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
