PORT=5000
NODE_ENV=development

# Database Configuration (SQL Server) - ten bien phai khop config/index.js
DB_SERVER=localhost
DB_USER=sa
DB_PASSWORD=YourPassword123
DB_NAME=AutoGaraDB
# DB_ENCRYPT=false        # bat buoc true (mac dinh) cho SQL Server tren Azure
# DB_TRUST_CERT=true      # can khi dung self-signed certificate

JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# URL FE (dùng trong link reset mật khẩu email)
FRONTEND_URL=http://localhost:3000

# SMTP Gmail — dùng App Password (không dùng mật khẩu đăng nhập thường)
# Tạo tại: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AutoGara <your-gmail@gmail.com>"
PASSWORD_RESET_EXPIRES_MINUTES=5
# true = nếu chưa có SMTP_USER/PASS thì dùng Ethereal (email test)
SMTP_ALLOW_ETHEREAL=true

# Origin FE duoc phep goi API (phan cach boi dau phay). Mac dinh 2 origin
# dev ben duoi neu khong set.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Khi chay bang Docker tren cung 1 may voi SQL Server (khong phai server
# rieng): doi DB_SERVER thanh host.docker.internal - xem docker-compose.yml.

# PayOS (thanh toan that qua QR dong) - lay tu dashboard PayOS cua cua hang.
# KHONG duoc de lo ra FE / dan vao chat, chi dien truc tiep vao file .env.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
